{% doc %}
  Free-shipping progress bar for the cart drawer and cart page.
  Mirrors the shipping rule: free Standard US shipping when the order total is $70.00 or more.

  @param {number} [threshold] - Free-shipping threshold in cents. Defaults to 7000.
{% enddoc %}

{%- liquid
  assign threshold = threshold | default: 7000
  assign total = cart.total_price
  assign remaining = threshold | minus: total
  assign percent = total | times: 100 | divided_by: threshold
  if percent > 100
    assign percent = 100
  endif
-%}

{%- if cart.item_count > 0 -%}
  <div class="ec-ship{% if remaining <= 0 %} ec-ship--done{% endif %}" role="status">
    <p class="ec-ship__msg">
      {%- if remaining > 0 -%}
        You're <strong>{{ remaining | money }}</strong> away from free US shipping
      {%- else -%}
        You've unlocked <strong>free US shipping</strong>
      {%- endif -%}
    </p>
    <div
      class="ec-ship__track"
      role="progressbar"
      aria-label="Progress toward free shipping"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ percent }}"
    >
      <span class="ec-ship__fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
(stylesheet block unchanged; omitted)
