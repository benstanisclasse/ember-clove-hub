{% comment %}
  Block contract.
  Three short reasons to buy, shown under the Buy now button: shipping, returns and secure checkout.
  Keep every line true to the store's policies; no review counts or ratings until real ones exist.
{% endcomment %}

<div class="ec-trust" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <p class="ec-trust__heading">{{ block.settings.heading | escape }}</p>
  {% endif %}
  <ul class="ec-trust__list" role="list">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'title_' | append: i
        assign text_key = 'text_' | append: i
        assign title = block.settings[title_key]
        assign text = block.settings[text_key]
      %}
      {% if title != blank %}
        <li class="ec-trust__item">
          <span class="ec-trust__icon" aria-hidden="true">
            {%- case i -%}
              {%- when 1 -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/></svg>
              {%- when 2 -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11a5 5 0 0 1 0 10H9"/><path d="M8 6 4 10l4 4"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
            {%- endcase -%}
          </span>
          <span class="ec-trust__body">
            <span class="ec-trust__title">{{ title | escape }}</span>
            {% if text != blank %}
              <span class="ec-trust__text">{{ text | escape }}</span>
            {% endif %}
          </span>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .ec-trust {
    width: 100%;
    margin-block: 4px;
  }

  .ec-trust__heading {
    margin: 0 0 12px;
    font-size: 0.875rem;
    text-align: center;
    color: var(--color-foreground-muted);
  }

  .ec-trust__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ec-trust__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ec-trust__icon {
    flex: none;
    display: inline-flex;
    margin-top: 1px;
  }

  .ec-trust__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ec-trust__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .ec-trust__text {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-foreground-muted);
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust lines",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" },
    { "type": "header", "content": "Shipping" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Free shipping on every order" },
    { "type": "text", "id": "text_1", "label": "Text", "default": "Tracked delivery. US orders can choose Express at checkout." },
    { "type": "header", "content": "Returns" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "7-day returns" },
    { "type": "text", "id": "text_2", "label": "Text", "default": "Request a return within 7 days of delivery." },
    { "type": "header", "content": "Checkout" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Secure checkout" },
    { "type": "text", "id": "text_3", "label": "Text", "default": "Payments are encrypted and processed by Shopify." }
  ],
  "presets": [{ "name": "Trust lines" }]
}
{% endschema %}
