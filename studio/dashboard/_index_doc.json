{"text": "<style>\n/* Control room for one TikTok character: what posts when, where each post is in the conveyor, and how the account grows. */\n.es { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); }\n.es-head { display: grid; gap: var(--cds-gap-xs); }\n.es-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.es-take { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); }\n.es-take b { color: var(--color-fg); font-weight: 500; }\n.es-tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); }\n.es-tile, .es-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.es-tile { display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.es-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.es-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.1; }\n.es-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.es-sec { display: grid; gap: var(--cds-gap-md); }\n.es-h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.es-note { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.es-grid2 { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n.es-card { display: grid; gap: var(--cds-gap-sm); align-content: start; }\n.es-weeks { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs); }\n.es-weeks button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: 999px; background: var(--color-bg); color: var(--color-fg); cursor: pointer; }\n.es-weeks button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); }\n.es-weeks button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.es-cal { display: grid; gap: var(--cds-gap-sm); grid-template-columns: repeat(7, minmax(0, 1fr)); min-height: 12rem; }\n.es-day { display: grid; gap: var(--cds-gap-xs); align-content: start; min-width: 0; }\n.es-dayname { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); }\n.es-slot { border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-sm); display: grid; gap: 2px; background: var(--color-bg); min-width: 0; border-left-width: 3px; }\n.es-slot .t { font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; color: var(--color-fg-muted); }\n.es-slot .s { font-size: var(--cds-font-size-caption); font-weight: var(--cds-font-weight-medium); overflow-wrap: anywhere; }\n.es-slot .p { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); overflow-wrap: anywhere; }\n.es-pill { white-space: nowrap; justify-self: start; font-size: 0.6875rem; letter-spacing: .02em; padding: 1px 6px; border-radius: 999px; border: 1px solid currentColor; margin-top: 2px; }\n.st-ok { color: var(--color-ok); } .st-warn { color: var(--color-warn); } .st-bad { color: var(--color-bad); } .st-muted { color: var(--color-fg-muted); }\n.es-slot.st-ok { border-left-color: var(--color-ok); } .es-slot.st-warn { border-left-color: var(--color-warn); }\n.es-slot.st-bad { border-left-color: var(--color-bad); } .es-slot.st-muted { border-left-color: var(--color-border-line); }\n.es-slot.st-ok, .es-slot.st-warn, .es-slot.st-bad, .es-slot.st-muted { color: var(--color-fg); }\n.es-chart { position: relative; min-height: 180px; }\n.es-chart svg text { fill: var(--color-fg-muted); font-size: var(--cds-font-size-caption); font-family: var(--font-anthropic-sans); }\n.es-empty { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.es-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n.es-tip .d { color: var(--cds-text-secondary); }\n.es-tablewrap { overflow: auto; max-height: 24rem; }\n.es-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.es-table th, .es-table td { text-align: left; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n.es-table th { position: sticky; top: 0; background: var(--color-panel); font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); }\n.es-table td.n, .es-table th.n { text-align: right; }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n@media (max-width: 760px) { .es-cal { grid-template-columns: 1fr; } .es-day { grid-template-columns: 4rem 1fr; } .es-day .es-slots { display: grid; gap: var(--cds-gap-xs); } }\n@media (min-width: 761px) { .es-day .es-slots { display: grid; gap: var(--cds-gap-xs); } }\n</style>\n\n<div class=\"es\">\n  <header class=\"es-head\">\n    <h1 class=\"es-title\" id=\"top\">Ember Studio Control Room</h1>\n    <p class=\"es-take\">Next up: <b data-source=\"next_post\" data-field=\"when\" data-row=\"0\" class=\"dash-skeleton\">—</b> ·\n      <span data-source=\"next_post\" data-field=\"series\" data-row=\"0\">—</span> ·\n      <span data-source=\"next_post\" data-field=\"status\" data-row=\"0\">—</span></p>\n  </header>\n\n  <section class=\"es-tiles\" aria-label=\"Headline figures\">\n    <div class=\"es-tile\"><span class=\"es-label\">Followers</span>\n      <span class=\"es-big dash-skeleton\" data-source=\"headline\" data-field=\"followers\" data-row=\"0\">—</span>\n      <span class=\"es-sub\">TikTok, latest count</span></div>\n    <div class=\"es-tile\"><span class=\"es-label\">Videos posted</span>\n      <span class=\"es-big dash-skeleton\" data-source=\"headline\" data-field=\"posted\" data-row=\"0\">—</span>\n      <span class=\"es-sub\">of <span data-source=\"headline\" data-field=\"planned\" data-row=\"0\">—</span> planned</span></div>\n    <div class=\"es-tile\"><span class=\"es-label\">Total views</span>\n      <span class=\"es-big dash-skeleton\" data-source=\"headline\" data-field=\"views\" data-row=\"0\">—</span>\n      <span class=\"es-sub\">all TikTok videos</span></div>\n    <div class=\"es-tile\"><span class=\"es-label\">Ready to post</span>\n      <span class=\"es-big dash-skeleton\" data-source=\"headline\" data-field=\"ready\" data-row=\"0\">—</span>\n      <span class=\"es-sub\">approved or scheduled</span></div>\n    <div class=\"es-tile\"><span class=\"es-label\">Spend this week</span>\n      <span class=\"es-big dash-skeleton\" data-source=\"headline\" data-field=\"spend_week\" data-row=\"0\">—</span>\n      <span class=\"es-sub\">of the <span data-source=\"headline\" data-field=\"week_cap\" data-row=\"0\">—</span> weekly cap</span></div>\n  </section>\n\n  <section class=\"es-sec\" id=\"calendar\">\n    <h2 class=\"es-h2\">Posting calendar</h2>\n    <p class=\"es-note\">Every planned post by day and time (Eastern). The color shows where it is: grey still in production, amber approved or waiting on TikTok, green live, red failed.</p>\n    <div class=\"es-weeks\" id=\"weeks\" role=\"group\" aria-label=\"Week\"></div>\n    <div class=\"es-cal\" id=\"cal\" data-source=\"schedule\"></div>\n  </section>\n\n  <section class=\"es-sec\" id=\"facebook\">\n    <h2 class=\"es-h2\">Facebook Page</h2>\n    <div class=\"es-card\">\n      <p class=\"es-note\">Photo posts planned for the Facebook Page (Eastern), real product photos only. Next up:\n        <b id=\"fbnext\">—</b></p>\n      <p class=\"es-empty\" id=\"fbempty\" hidden>No Facebook posts planned yet.</p>\n      <div class=\"es-tablewrap\"><table class=\"es-table\" id=\"fbtable\" data-source=\"fb_schedule\">\n        <thead><tr><th>Day</th><th>Time</th><th>Type</th><th>Products</th><th class=\"n\">Photos</th><th>Status</th></tr></thead>\n        <tbody></tbody></table></div>\n    </div>\n  </section>\n\n  <section class=\"es-sec\" id=\"pipeline\">\n    <h2 class=\"es-h2\">Pipeline</h2>\n    <div class=\"es-card\">\n      <p class=\"es-note\">How many planned posts are at each stage, from planned to live.</p>\n      <div class=\"es-chart\" id=\"stages\" data-source=\"stage_counts\"></div>\n    </div>\n  </section>\n\n  <section class=\"es-sec\" id=\"growth\">\n    <h2 class=\"es-h2\">Growth</h2>\n    <div class=\"es-grid2\">\n      <div class=\"es-card\"><h3 class=\"es-h2\">Followers</h3><p class=\"es-note\">Daily follower count from TikTok, via PostZen.</p>\n        <div class=\"es-chart\" id=\"fchart\" data-source=\"followers\"></div></div>\n      <div class=\"es-card\"><h3 class=\"es-h2\">Daily views</h3><p class=\"es-note\">Views per day across public TikTok videos.</p>\n        <div class=\"es-chart\" id=\"vchart\" data-source=\"daily_metrics\"></div></div>\n    </div>\n  </section>\n\n  <section class=\"es-sec\" id=\"videos\">\n    <h2 class=\"es-h2\">Video performance</h2>\n    <div class=\"es-card\">\n      <p class=\"es-note\">Each TikTok video's lifetime numbers. TikTok reports public videos only.</p>\n      <p class=\"es-empty\" id=\"vempty\" hidden>No TikTok videos live yet. See the posting schedule for the next one.</p>\n      <div class=\"es-tablewrap\"><table class=\"es-table\" id=\"vtable\" data-source=\"tiktok_videos\" data-row-key=\"post_id\">\n        <thead><tr><th data-field=\"published\">Posted</th><th data-field=\"caption\">Caption</th><th class=\"n\" data-field=\"views\">Views</th>\n          <th class=\"n\" data-field=\"impressions\">Impressions</th><th class=\"n\" data-field=\"reach\">Reach</th>\n          <th class=\"n\" data-field=\"likes\">Likes</th><th class=\"n\" data-field=\"comments\">Comments</th><th class=\"n\" data-field=\"shares\">Shares</th>\n          <th class=\"n\" data-field=\"saves\">Saves</th><th class=\"n\" data-field=\"clicks\">Clicks</th></tr></thead>\n        <tbody></tbody></table></div>\n    </div>\n    <div class=\"es-card\">\n      <h3 class=\"es-h2\">Day by day, per post</h3>\n      <p class=\"es-note\">How each live post's numbers build up over its first days. Newest day first.</p>\n      <p class=\"es-empty\" id=\"tempty\" hidden>Nothing yet: a post gets a timeline once it is live.</p>\n      <div class=\"es-tablewrap\"><table class=\"es-table\" id=\"ttable\" data-source=\"post_timeline\">\n        <thead><tr><th data-field=\"date\">Day</th><th data-field=\"caption\">Post</th><th class=\"n\" data-field=\"views\">Views</th>\n          <th class=\"n\" data-field=\"impressions\">Impressions</th><th class=\"n\" data-field=\"likes\">Likes</th>\n          <th class=\"n\" data-field=\"shares\">Shares</th><th class=\"n\" data-field=\"saves\">Saves</th><th class=\"n\" data-field=\"clicks\">Clicks</th></tr></thead>\n        <tbody></tbody></table></div>\n    </div>\n  </section>\n\n  <section class=\"es-sec\" id=\"spend\">\n    <h2 class=\"es-h2\">Spend</h2>\n    <div class=\"es-card\">\n      <p class=\"es-note\">Video and image generation cost per day. The dashed line is the daily cap.</p>\n      <div class=\"es-chart\" id=\"schart\" data-source=\"spend caps\"></div>\n    </div>\n  </section>\n</div>\n\n<script>\nconst STAGES = ['PLANNED', 'SCRIPTED', 'GENERATED', 'QA_FAILED', 'QA_PASSED', 'APPROVED', 'SCHEDULED', 'POSTED'];\nconst STAGE_NAME = {PLANNED: 'Planned', SCRIPTED: 'Scripted', GENERATED: 'Generated', QA_FAILED: 'QA failed', QA_PASSED: 'QA passed',\n  APPROVED: 'Approved', REJECTED: 'Rejected', SCHEDULED: 'Scheduled', POSTED: 'Posted', MEASURED: 'Measured'};\n\ndash.calc('headline', {\n  title: 'Headline figures', description: 'Latest followers, posts live and planned, total views, posts ready, and spend in the week of the latest spend.',\n  inputs: ['schedule', 'followers', 'tiktok_videos', 'spend', 'caps'],\n  fn: (schedule, followers, tiktok_videos, spend, caps) => {\n    const last = followers.length ? followers[followers.length - 1] : null;\n    const latest = spend.length ? new Date(spend[spend.length - 1].date + 'T00:00:00Z') : null;\n    const monday = latest ? new Date(latest.getTime() - ((latest.getUTCDay() + 6) % 7) * 864e5) : null;\n    const weekSpend = monday ? spend.filter(r => new Date(r.date + 'T00:00:00Z') >= monday).reduce((s, r) => s + Number(r.usd), 0) : 0;\n    const cap = caps.find(c => c.cap === 'per week');\n    return [{\n      followers: last ? Number(last.followers) : null,\n      posted: schedule.filter(r => r.stage === 'POSTED' || r.stage === 'MEASURED').length,\n      planned: schedule.length,\n      views: tiktok_videos.reduce((s, r) => s + (Number(r.views) || 0), 0),\n      ready: schedule.filter(r => r.stage === 'APPROVED' || r.stage === 'SCHEDULED').length,\n      spend_week: Math.round(weekSpend * 100) / 100,\n      week_cap: cap ? Number(cap.usd) : null,\n    }];\n  },\n});\n\ndash.calc('next_post', {\n  title: 'Next post', description: 'The earliest planned post that is not live yet, with where it stands.',\n  inputs: ['schedule'],\n  fn: (schedule) => {\n    const open = schedule.filter(r => r.stage !== 'POSTED' && r.stage !== 'MEASURED')\n      .sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));\n    if (!open.length) return [];\n    const r = open[0];\n    const tiktok = r.tiktok ? `TikTok: ${r.tiktok}` : (r.stage === 'SCHEDULED' ? 'not sent to TikTok yet' : 'not ready yet');\n    return [{episode: r.episode, when: `${r.weekday} ${r.date.slice(5)} ${r.time}`, series: r.series,\n             status: `${r.stage.toLowerCase().replace('_', ' ')}, ${tiktok}`}];\n  },\n});\n\ndash.calc('stage_counts', {\n  title: 'Posts by stage', description: 'How many planned posts are at each stage of the conveyor.',\n  inputs: ['schedule'],\n  fn: (schedule) => ['PLANNED', 'SCRIPTED', 'GENERATED', 'QA_FAILED', 'QA_PASSED', 'APPROVED', 'SCHEDULED', 'POSTED']\n    .map(stage => ({stage, posts: schedule.filter(r => r.stage === stage).length})),\n});\n\nconst fmt = d3.format(',');\nconst usd = d3.format('$,.2f');\nconst tone = (r) => r.stage === 'POSTED' || r.stage === 'MEASURED' ? 'st-ok'\n  : (r.stage === 'QA_FAILED' || r.stage === 'REJECTED' || /fail|error/i.test(r.tiktok || '')) ? 'st-bad'\n  : (r.stage === 'APPROVED' || r.stage === 'SCHEDULED') ? 'st-warn' : 'st-muted';\nlet week = null;\n\nfunction fill(id, el, field, f) {\n  const d = dash.data(id);\n  el.classList.toggle('dash-skeleton', d.status === 'loading');\n  const row = d.status === 'ok' ? (d.data[0] || null) : null;\n  el.textContent = row && row[field] != null ? (f ? f(row[field]) : row[field]) : '—';\n}\n\nfunction failed(box) {\n  box.replaceChildren();\n  const line = d3.select(box).append('div').style('display', 'flex').style('align-items', 'center').style('justify-content', 'center')\n    .style('gap', '6px').style('min-height', '160px');\n  line.append('span').style('width', '0.375rem').style('height', '0.375rem').style('border-radius', '50%').style('background', 'var(--color-bad)');\n  line.append('span').style('color', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)').text('Failed to load');\n}\n\nfunction drawCalendar() {\n  const box = document.getElementById('cal');\n  const weeksEl = document.getElementById('weeks');\n  const d = dash.data('schedule');\n  box.classList.toggle('dash-skeleton', d.status === 'loading');\n  if (d.status === 'error') { weeksEl.replaceChildren(); return failed(box); }\n  if (d.status !== 'ok') { box.replaceChildren(); weeksEl.replaceChildren(); return; }\n  const rows = d.data;\n  const mondayOf = (s) => { const t = new Date(s + 'T00:00:00Z'); return d3.utcFormat('%Y-%m-%d')(new Date(t - ((t.getUTCDay() + 6) % 7) * 864e5)); };\n  const weeks = [...new Set(rows.map(r => mondayOf(r.date)))].sort();\n  if (!week || !weeks.includes(week)) {\n    const open = rows.find(r => r.stage !== 'POSTED' && r.stage !== 'MEASURED');\n    week = open ? mondayOf(open.date) : weeks[weeks.length - 1];\n  }\n  weeksEl.replaceChildren(...weeks.map(w => {\n    const b = document.createElement('button');\n    b.type = 'button';\n    b.textContent = 'Week of ' + d3.utcFormat('%b %-d')(new Date(w + 'T00:00:00Z'));\n    b.setAttribute('aria-pressed', String(w === week));\n    b.addEventListener('click', () => { week = w; drawCalendar(); });\n    return b;\n  }));\n  const start = new Date(week + 'T00:00:00Z');\n  const days = d3.range(7).map(i => d3.utcFormat('%Y-%m-%d')(new Date(start.getTime() + i * 864e5)));\n  box.replaceChildren(...days.map(day => {\n    const col = document.createElement('div');\n    col.className = 'es-day';\n    const name = document.createElement('div');\n    name.className = 'es-dayname';\n    name.textContent = d3.utcFormat('%a %b %-d')(new Date(day + 'T00:00:00Z'));\n    const slots = document.createElement('div');\n    slots.className = 'es-slots';\n    rows.filter(r => r.date === day).sort((a, b) => a.time.localeCompare(b.time)).forEach(r => {\n      const card = document.createElement('div');\n      card.className = 'es-slot ' + tone(r);\n      card.title = r.episode;\n      const t = document.createElement('div'); t.className = 't'; t.textContent = `${r.time} · ${r.location}`;\n      const s = document.createElement('div'); s.className = 's'; s.textContent = r.series;\n      const p = document.createElement('div'); p.className = 'p'; p.textContent = r.store_piece;\n      const pill = document.createElement('span'); pill.className = 'es-pill ' + tone(r);\n      pill.textContent = STAGE_NAME[r.stage] || r.stage;\n      card.append(t, s, p, pill);\n      if (r.tiktok) { const k = document.createElement('div'); k.className = 'p'; k.textContent = 'TikTok: ' + r.tiktok; card.append(k); }\n      slots.append(card);\n    });\n    col.append(name, slots);\n    return col;\n  }));\n}\n\nfunction tooltip(box) {\n  let tip = box.querySelector('.es-tip');\n  if (!tip) { tip = document.createElement('div'); tip.className = 'es-tip'; tip.hidden = true; box.append(tip); }\n  return tip;\n}\n\nfunction bars(boxId, id, rows, xKey, yKey, opts = {}) {\n  const box = document.getElementById(boxId);\n  const d = dash.data(id);\n  box.classList.toggle('dash-skeleton', d.status === 'loading');\n  if (d.status === 'error') return failed(box);\n  box.replaceChildren();\n  if (d.status !== 'ok') return;\n  if (!rows.length) { const e = document.createElement('p'); e.className = 'es-empty'; e.textContent = opts.empty || 'No data yet.'; box.append(e); return; }\n  const W = Math.max(280, box.clientWidth), H = 180, m = {t: 12, r: 12, b: 26, l: 36};\n  const x = d3.scaleBand(rows.map(r => r[xKey]), [m.l, W - m.r]).padding(0.3);\n  const top = Math.max(d3.max(rows, r => Number(r[yKey])) || 0, opts.ref || 0, 1);\n  const y = d3.scaleLinear([0, top], [H - m.b, m.t]).nice(4);\n  const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1', m.l).attr('x2', W - m.r)\n    .attr('y1', v => y(v)).attr('y2', v => y(v)).attr('stroke', 'var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x', m.l - 6).attr('y', v => y(v) + 4)\n    .attr('text-anchor', 'end').text(v => (opts.yfmt || fmt)(v));\n  const step = Math.ceil(rows.length / Math.max(1, Math.floor((W - m.l - m.r) / 64)));\n  svg.append('g').selectAll('text').data(rows.filter((r, i) => i % step === 0)).join('text')\n    .attr('x', r => x(r[xKey]) + x.bandwidth() / 2).attr('y', H - 8).attr('text-anchor', 'middle').text(r => (opts.xfmt || String)(r[xKey]));\n  svg.append('g').selectAll('rect').data(rows).join('rect').attr('x', r => x(r[xKey]) + Math.max(0, (x.bandwidth() - 32) / 2))\n    .attr('width', Math.min(32, x.bandwidth())).attr('y', r => y(Number(r[yKey]))).attr('height', r => y(0) - y(Number(r[yKey])))\n    .attr('rx', 4).attr('fill', r => (opts.color ? opts.color(r) : dash.colors[0]));\n  if (opts.ref) svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(opts.ref)).attr('y2', y(opts.ref))\n    .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 4');\n  const tip = tooltip(box);\n  svg.selectAll('rect').on('mousemove', (ev, r) => {\n    tip.hidden = false;\n    tip.replaceChildren();\n    const a = document.createElement('div'); a.className = 'd'; a.textContent = (opts.xfmt || String)(r[xKey]);\n    const b = document.createElement('div'); b.textContent = (opts.label || yKey) + ': ' + (opts.tipfmt || opts.yfmt || fmt)(Number(r[yKey]));\n    tip.append(a, b);\n    const [px, py] = d3.pointer(ev, box);\n    tip.style.left = Math.min(px + 12, box.clientWidth - tip.offsetWidth) + 'px';\n    tip.style.top = Math.max(0, py - 40) + 'px';\n  }).on('mouseleave', () => { tip.hidden = true; });\n}\n\nfunction line(boxId, id, rows, xKey, yKey, empty) {\n  const box = document.getElementById(boxId);\n  const d = dash.data(id);\n  box.classList.toggle('dash-skeleton', d.status === 'loading');\n  if (d.status === 'error') return failed(box);\n  box.replaceChildren();\n  if (d.status !== 'ok') return;\n  if (!rows.length) { const e = document.createElement('p'); e.className = 'es-empty'; e.textContent = empty; box.append(e); return; }\n  const pts = rows.map(r => ({x: new Date(r[xKey] + 'T00:00:00Z'), y: Number(r[yKey])}));\n  const W = Math.max(280, box.clientWidth), H = 180, m = {t: 14, r: 56, b: 26, l: 36};\n  const ext = d3.extent(pts, p => p.x);\n  if (+ext[0] === +ext[1]) { ext[0] = new Date(+ext[0] - 3 * 864e5); ext[1] = new Date(+ext[1] + 3 * 864e5); }\n  const x = d3.scaleUtc(ext, [m.l, W - m.r]);\n  const y = d3.scaleLinear([0, Math.max(d3.max(pts, p => p.y), 10)], [H - m.b, m.t]).nice(4);\n  const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line').attr('x1', m.l).attr('x2', W - m.r)\n    .attr('y1', v => y(v)).attr('y2', v => y(v)).attr('stroke', 'var(--cds-chart-grid)');\n  svg.append('g').selectAll('text').data(y.ticks(4)).join('text').attr('x', m.l - 6).attr('y', v => y(v) + 4).attr('text-anchor', 'end').text(fmt);\n  svg.append('g').selectAll('text').data(x.ticks(Math.max(2, Math.floor((W - m.l - m.r) / 80)))).join('text')\n    .attr('x', v => x(v)).attr('y', H - 8).attr('text-anchor', 'middle').text(d3.utcFormat('%b %-d'));\n  svg.append('path').datum(pts).attr('fill', 'none').attr('stroke', dash.colors[0]).attr('stroke-width', 2)\n    .attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round').attr('d', d3.line(p => x(p.x), p => y(p.y)));\n  const end = pts[pts.length - 1];\n  svg.append('circle').attr('cx', x(end.x)).attr('cy', y(end.y)).attr('r', 4).attr('fill', dash.colors[0]);\n  svg.append('text').attr('x', x(end.x) + 8).attr('y', y(end.y) + 4).text(fmt(end.y));\n}\n\nfunction drawTable(source = 'tiktok_videos', table = 'vtable', emptyId = 'vempty', sortKey = 'published', rowKey = 'post_id',\n                   cols = [['published', 0], ['caption', 0], ['views', 1], ['impressions', 1], ['reach', 1], ['likes', 1],\n                           ['comments', 1], ['shares', 1], ['saves', 1], ['clicks', 1]], prep = r => r) {\n  const d = dash.data(source);\n  const body = document.querySelector(`#${table} tbody`);\n  const empty = document.getElementById(emptyId);\n  body.replaceChildren();\n  empty.hidden = !(d.status === 'ok' && !d.data.length);\n  if (d.status !== 'ok') return;\n  [...d.data].map(prep).sort((a, b) => String(b[sortKey]).localeCompare(String(a[sortKey]))).forEach(r => {\n    const tr = document.createElement('tr');\n    tr.dataset.key = r[rowKey];\n    cols.forEach(([k, n]) => {\n      const td = document.createElement('td');\n      if (n) td.className = 'n';\n      td.textContent = n ? (r[k] == null ? '—' : fmt(Number(r[k]))) : (r[k] || '');\n      tr.append(td);\n    });\n    body.append(tr);\n  });\n}\n\nfunction drawFacebook() {\n  const d = dash.data('fb_schedule');\n  const body = document.querySelector('#fbtable tbody');\n  const next = document.getElementById('fbnext');\n  body.replaceChildren();\n  if (d.status !== 'ok') { next.textContent = '—'; return; }\n  const today = d3.timeFormat('%Y-%m-%d')(new Date());\n  const rows = d.data.filter(r => r.date >= today);\n  document.getElementById('fbempty').hidden = rows.length > 0;\n  const open = rows.find(r => !/published|posted/i.test(r.status));\n  next.textContent = open ? `${open.weekday} ${open.date.slice(5)} ${open.time} · ${open.products}` : 'nothing planned';\n  const ftone = s => /published|posted/i.test(s) ? 'st-ok' : /fail|error/i.test(s) ? 'st-bad' : /scheduled/i.test(s) ? 'st-warn' : 'st-muted';\n  rows.slice(0, 14).forEach(r => {\n    const tr = document.createElement('tr');\n    [`${r.weekday} ${r.date.slice(5)}`, r.time, r.kind === 'outfit' ? 'Outfit' : 'Product', r.products, r.photos].forEach((v, i) => {\n      const td = document.createElement('td'); if (i === 4) td.className = 'n'; td.textContent = v; tr.append(td);\n    });\n    const td = document.createElement('td');\n    const pill = document.createElement('span'); pill.className = 'es-pill ' + ftone(r.status); pill.textContent = r.status;\n    td.append(pill); tr.append(td); body.append(tr);\n  });\n}\n\ndash.onData(() => {\n  drawFacebook();\n  ['when', 'series', 'status'].forEach(f => fill('next_post', document.querySelector(`[data-source=\"next_post\"][data-field=\"${f}\"]`), f));\n  const h = {followers: fmt, posted: fmt, planned: fmt, views: v => v >= 10000 ? Intl.NumberFormat('en', {notation: 'compact', maximumFractionDigits: 1}).format(v) : fmt(v),\n    ready: fmt, spend_week: usd, week_cap: usd};\n  Object.entries(h).forEach(([f, ff]) => document.querySelectorAll(`[data-source=\"headline\"][data-field=\"${f}\"]`).forEach(el => fill('headline', el, f, ff)));\n  drawCalendar();\n  const sc = dash.data('stage_counts');\n  bars('stages', 'stage_counts', sc.status === 'ok' ? sc.data.map(r => ({...r, name: STAGE_NAME[r.stage]})) : [], 'name', 'posts',\n    {label: 'Posts', color: r => r.stage === 'POSTED' ? 'var(--color-ok)' : r.stage === 'QA_FAILED' ? 'var(--cds-chart-status-critical)' : dash.colors[0]});\n  const fo = dash.data('followers');\n  line('fchart', 'followers', fo.status === 'ok' ? fo.data : [], 'date', 'followers', 'No follower history yet.');\n  const dm = dash.data('daily_metrics');\n  bars('vchart', 'daily_metrics', dm.status === 'ok' ? dm.data : [], 'date', 'views',\n    {label: 'Views', empty: 'No views yet: nothing is live on TikTok.', xfmt: s => d3.utcFormat('%b %-d')(new Date(s + 'T00:00:00Z'))});\n  drawTable();\n  const sch = dash.data('schedule');\n  const capOf = Object.fromEntries((sch.status === 'ok' ? sch.data : []).map(r => [r.episode, r.caption]));\n  drawTable('post_timeline', 'ttable', 'tempty', 'date', 'date',\n    [['date', 0], ['caption', 0], ['views', 1], ['impressions', 1], ['likes', 1], ['shares', 1], ['saves', 1], ['clicks', 1]],\n    r => ({...r, caption: capOf[r.episode] || r.episode}));\n  const sp = dash.data('spend'), cp = dash.data('caps');\n  const dayCap = cp.status === 'ok' ? Number((cp.data.find(c => c.cap === 'per day') || {}).usd) : 0;\n  bars('schart', 'spend', sp.status === 'ok' ? sp.data : [], 'date', 'usd',\n    {label: 'Spend', ref: dayCap, yfmt: d3.format('$,.0f'), tipfmt: usd, empty: 'Nothing spent yet.',\n     xfmt: s => d3.utcFormat('%b %-d')(new Date(s + 'T00:00:00Z')),\n     color: r => Number(r.usd) > dayCap ? 'var(--cds-chart-status-critical)' : dash.colors[1]});\n});\n</script>\n"}