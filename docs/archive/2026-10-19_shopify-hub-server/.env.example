# =====================================================================================
# Shopify hub -- environment. Copy to .env (scripts/setup.sh does this and fills in
# generated secrets). NEVER commit .env. Values marked (generated) are created by setup.
# Runtime business rules (spend caps, read-only, kill switch) are NOT here -- they live
# in the database: docker compose exec api python -m app.cli settings show
# =====================================================================================

# --- App -------------------------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true
# Public HTTPS hostname served through the Cloudflare Tunnel
PUBLIC_BASE_URL=https://hub.my-domain.com

# --- Store -----------------------------------------------------------------------------
# IANA timezone of the Shopify store; order dates and daily metrics are bucketed in it.
STORE_TIMEZONE=America/New_York
STORE_CURRENCY=USD
STORE_NICHE=[product category / niche]

# --- Network ---------------------------------------------------------------------------
# Where Caddy's LAN/admin listener (port 8081) is published. 127.0.0.1 = this VM only;
# set to the VM's LAN IP (e.g. 192.168.1.210) to reach /admin and /health/ready from the LAN.
ADMIN_BIND_ADDR=127.0.0.1
# Bearer token for /admin/* routes (generated)
ADMIN_TOKEN=

# --- Postgres --------------------------------------------------------------------------
POSTGRES_USER=hub
POSTGRES_DB=hub
# (generated) hex only, so it is safe inside the DATABASE_URL
POSTGRES_PASSWORD=

# --- Object storage (S3-compatible) -----------------------------------------------------
# garage (default, runs in the stack) | r2 | s3
STORAGE_PROVIDER=garage
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_BUCKET=hub-creatives
# (generated by scripts/garage-init.sh for Garage)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/CDN base URL for objects; empty = private (s3:// URLs + presigned links)
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=3600
# Cloudflare R2 instead of Garage:
#   STORAGE_PROVIDER=r2
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<r2 token access key>  S3_SECRET_ACCESS_KEY=<r2 token secret>

# Garage internals (generated)
GARAGE_VERSION=v2.2.0
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# --- Cloudflare Tunnel -----------------------------------------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > "Install connector" token
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.8.1

# --- Alerts ----------------------------------------------------------------------------
# Slack incoming webhook (Slack app > Incoming Webhooks)
SLACK_WEBHOOK_URL=
# External dead-man's switch, e.g. https://hc-ping.com/<uuid> (healthchecks.io).
# Pinged every 5 min when healthy; alerts you if the VM/stack goes silent.
HEARTBEAT_URL=
ALERT_COOLDOWN_MINUTES=60

# --- Backups (scripts/backup.sh) -------------------------------------------------------
# Local dump dir inside the VM; the nightly Proxmox vzdump (02:30) copies the whole VM,
# including this dir, to the Synology.
BACKUP_DIR=/var/backups/shopify-hub
BACKUP_RETENTION_DAYS=14
# Optional offsite copy with restic (Backblaze B2 / Cloudflare R2 / any S3). Empty = skip.
#   B2 (S3 API): s3:https://s3.us-west-004.backblazeb2.com/my-bucket/shopify-hub
#   R2:          s3:https://<account_id>.r2.cloudflarestorage.com/my-bucket/shopify-hub
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_S3_ACCESS_KEY_ID=
RESTIC_S3_SECRET_ACCESS_KEY=

# =====================================================================================
# Used from later phases -- leave empty until then
# =====================================================================================

# --- Phase 2: Shopify -------------------------------------------------------------------
# App created in the Shopify Dev Dashboard (dev.shopify.com) and installed on your store.
# The hub exchanges the client id/secret for a 24h Admin API token automatically
# (client credentials grant). The client secret also verifies webhook signatures.
SHOPIFY_STORE_DOMAIN=[store-name].myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for an old (pre-2026) admin-created custom app token (shpat_...). Leave empty otherwise.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# How far back the first order import goes. Without the read_all_orders scope (needs Shopify
# approval) Shopify only returns the last 60 days.
SHOPIFY_BACKFILL_DAYS=60
# Fee estimate for payments Shopify reports no fees for (PayPal, Stripe, ...): pct% + fixed
PAYMENT_FEE_FALLBACK_PCT=2.9
PAYMENT_FEE_FALLBACK_FIXED=0.30

# --- Phase 3: ad platforms (see docs/ad-platforms.md) -------------------------------------
# Metrics re-read window: hourly sync re-reads N days; nightly re-reads M (late conversions).
ADS_METRICS_LOOKBACK_DAYS=3
ADS_NIGHTLY_LOOKBACK_DAYS=7

# Google Ads (REST API) -- developer token from your manager (MCC) account's API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# digits only (dashes are stripped); LOGIN = the manager account, if the ad account is under one
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_BUSINESS_NAME=
# YouTube upload for Google video ads (same OAuth client, youtube.upload scope)
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Meta Marketing API -- system user token (Business Settings > Users > System users)
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
META_API_VERSION=v26.0

# TikTok API for Business -- advertiser access token from your developer app's OAuth flow
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_ID=
# The TikTok account that authors the ads (Spark Ads): TT_USER, or BC_AUTH_TT plus its
# Business Center id. Custom identities (CUSTOMIZED_USER) can no longer run on TikTok.
TIKTOK_IDENTITY_ID=
TIKTOK_IDENTITY_TYPE=TT_USER
TIKTOK_IDENTITY_AUTHORIZED_BC_ID=
# Dynamic CTA portfolio id; left empty, the hub creates one on the first ad and logs its id
TIKTOK_CTA_PORTFOLIO_ID=
TIKTOK_API_VERSION=v1.3

# --- Phase 3b: conversions (see docs/conversions.md) -----------------------------------
# On/off and hashed-PII live in DB settings: app.cli settings set conversions_enabled true
# TikTok: Events Manager > your pixel > Settings > Events API > Generate access token
TIKTOK_EVENTS_ACCESS_TOKEN=
# The alphanumeric pixel code (C...); TIKTOK_PIXEL_ID above is the numeric id
TIKTOK_PIXEL_CODE=
# Filled from `conversions create-pixels google`
GOOGLE_ADS_CONVERSION_ACTION=
# Optional: route events to the platforms' test consoles while you verify
META_CAPI_TEST_EVENT_CODE=
TIKTOK_TEST_EVENT_CODE=
CONVERSIONS_PURCHASE_DELAY_S=120
# Optional: lets scripts/deploy-web-pixel.sh run Shopify CLI without an interactive login
SHOPIFY_CLI_PARTNERS_TOKEN=

# --- Phase 4: Higgsfield (console.higgsfield.ai > API keys) ------------------------------
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Image default works out of the box; pick a video model id in the console (e.g. a Kling or
# Seedance image-to-video endpoint) -- there is no public catalog API.
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
HIGGSFIELD_VIDEO_MODEL=
HIGGSFIELD_EXTRA_MODELS=
# (generated) secret path segment for /webhooks/higgsfield/<token>
HIGGSFIELD_WEBHOOK_TOKEN=
HIGGSFIELD_JOB_TIMEOUT_MINUTES=120
# Square logo asset for Google Demand Gen video ads (upload once: app.cli ads upload-logo)
GOOGLE_ADS_LOGO_ASSET=

# --- Phase 5: MCP server (see docs/mcp.md) ------------------------------------------------
# (generated) static bearer token for Claude Code: Authorization: Bearer <token>
MCP_BEARER_TOKEN=
# (generated) password you type once when connecting Claude (claude.ai / Desktop / mobile)
MCP_OWNER_PASSWORD=
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
MCP_CIMD_HOSTS=claude.ai,claude.com
# Your storefront (landing pages for launched ads); defaults to https://<SHOPIFY_STORE_DOMAIN>
STORE_PUBLIC_URL=
APPROVAL_EXPIRY_HOURS=72
