[Unit]
Description=Shopify hub (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__USER__
WorkingDirectory=__REPO__
ExecStart=/usr/bin/bash -c 'source scripts/lib.sh && compose up -d --remove-orphans'
# Graceful stop on VM shutdown so Postgres flushes cleanly.
ExecStop=/usr/bin/bash -c 'source scripts/lib.sh && compose stop -t 60'
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
