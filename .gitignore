# Repository (private GitHub remote: benstanisclasse/ember-clove-hub). Code, config, docs, plans and logs are tracked;
# large media, raw exports, databases, backups and anything secret are not.

# Secrets (keys live in Windows user environment variables, never in files)
*.key
key.txt
.env
*.env

# Databases and their journals (backed up nightly to backups/, not versioned)
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated / heavy
backups/
logs/
__pycache__/
*.pyc
.pytest_cache/
# research/: reports, audits and small CSVs are tracked; data and model outputs are backed up, not versioned
research/**/raw/
research/**/videos/
research/tiktok/ads/
research/kalodata/model_*/
research/kalodata/pilot_model_*/
research/kalodata/snapshots/
research/**/*.joblib
research/**/*.gz
research/**/*.log
research/**/*.jsonl
research/kalodata/video_links_core.csv
assets/
studio/episodes/
studio/refs/
data/media_generated/
data/media_originals/
data/sizes/
data/inbox/
data/feeds/
theme-staging/

# Media anywhere else (brand/ is the exception)
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.pdf
!brand/**

# Dashboard data files are regenerated by the syncs every 15 minutes
studio/dashboard/*.json
studio/dashboard/*.csv
studio/dashboard/synced_at.txt
